[Unit]
Description=PiCase management-bus master (RS-485 over the GPIO backplane)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/picase/controller/bus_master.py --slots __SLOTS__
Restart=always
RestartSec=2
RuntimeDirectory=picase
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
